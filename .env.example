# Copy to .env for local (non-Docker) development: cp .env.example .env
NODE_ENV=development
PROCESS_ROLE=all            # all | api | worker
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carrierbridge
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# Worker
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=500
TASK_LEASE_MS=60000
TASK_TIMEOUT_MS=45000
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BASE_DELAY_MS=2000
SHUTDOWN_TIMEOUT_MS=15000

# Carrier transport
CARRIER_HTTP_TIMEOUT_MS=10000
CARRIER_HTTP_MAX_RETRIES=3
CARRIER_HTTP_RETRY_BASE_DELAY_MS=200
CARRIER_HTTP_RETRY_MAX_DELAY_MS=5000
CARRIER_HTTP_MAX_RETRY_AFTER_MS=30000
BROWSER_HEADLESS=true
BROWSER_NAVIGATION_TIMEOUT_MS=15000
# BROWSER_EXECUTABLE_PATH=/path/to/chromium   # only if not using Playwright's bundled browser

# Carriers (mock services from `npm run dev:mocks`)
CARRIER_A_BASE_URL=http://localhost:4001
CARRIER_B_BASE_URL=http://localhost:4002
CARRIER_C_BASE_URL=http://localhost:4003
CARRIER_A_CONCURRENCY=4
CARRIER_B_CONCURRENCY=2
CARRIER_C_CONCURRENCY=2
