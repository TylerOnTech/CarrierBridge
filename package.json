{
  "name": "carrierbridge",
  "version": "0.1.0",
  "private": true,
  "description": "CarrierBridge: an insurance carrier integration engine that retrieves, normalizes, and serves policy data from heterogeneous (mock) carriers.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "start:mocks": "node dist/mock-carriers/server.js",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:mocks": "tsx mock-carriers/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:seed:prod": "node --env-file-if-exists=.env dist/prisma/seed.js",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "generate:contract": "tsx scripts/generate-contract-schema.ts",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "express": "5.1.0",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "playwright": "1.63.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@types/express": "5.0.3",
    "@types/node": "22.18.12",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "9.38.0",
    "pino-pretty": "13.1.2",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "4.1.12",
    "vite": "7.3.7"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "vite": "$vite"
  }
}
